#!/bin/bash
#PBS -N cmip_exp3_mask_pipeline
#PBS -A UCLB0066
#PBS -q main
#PBS -l select=1:ncpus=10:mem=20GB:ngpus=1
#PBS -l walltime=01:00:00
#PBS -o /glade/u/home/tsalin/CMIP/logs/exp3_mask_pipeline.out
#PBS -e /glade/u/home/tsalin/CMIP/logs/exp3_mask_pipeline.err

set -euo pipefail

# Pré-soumettre le job suivant avant de commencer : il ne démarrera que si ce
# job se termine en erreur (walltime, OOM, crash), pas si exit 0.
NEXT_JOB=$(qsub -W depend=afternotok:"$PBS_JOBID" \
  ${NUM_SAMPLE:+-v NUM_SAMPLE="$NUM_SAMPLE"} \
  "$PBS_O_WORKDIR/run_exp3_mask_pipeline.pbs")
echo "[PBS] Job successeur pré-soumis : $NEXT_JOB (démarre uniquement si ce job échoue)"

PROJECT_DIR="/glade/u/home/tsalin/CMIP"
WORK_DIR="/glade/work/tsalin/CMIP"
mkdir -p "$PROJECT_DIR/logs"
mkdir -p "$PROJECT_DIR/model_evaluation/exp3"
cd "$PROJECT_DIR/jobs"

# Initialize conda in PBS shell
__conda_setup="$('/glade/u/apps/jupyterhub/jh-23.11/bin/conda' 'shell.bash' 'hook' 2>/dev/null)"
if [ $? -eq 0 ]; then eval "$__conda_setup"; fi
unset __conda_setup
module load conda
conda activate cmip

# Optional override, e.g.
# qsub -v NUM_SAMPLE=20000 run_exp3_mask_pipeline.pbs
NUM_SAMPLE_ARG=()
if [[ -n "${NUM_SAMPLE:-}" ]]; then
  NUM_SAMPLE_ARG=(--num-sample "${NUM_SAMPLE}")
fi

python -u run_exp3_mask_pipeline.py \
  --project-dir "$PROJECT_DIR" \
  --notebook notebooks/trainings/mask/CMIP_mask_exp3.ipynb \
  --plots-dir "$WORK_DIR/plots/plots_exp_3" \
  --latents-dir "$WORK_DIR/latent_representations/latent_representations_exp_3" \
  --evaluation-dir "$WORK_DIR/model_evaluation/exp3" \
  --executed-notebook "$WORK_DIR/executed_notebooks/CMIP_mask_exp3.executed.ipynb" \
  --timeout 0 \
  "${NUM_SAMPLE_ARG[@]}"

# Si Python s'est terminé normalement (exit 0), annuler le job successeur
# car tout est fini — le checkpoint a été supprimé par le notebook.
qdel "$NEXT_JOB" 2>/dev/null && echo "[PBS] Job successeur annulé : entraînement et évaluation terminés." || true