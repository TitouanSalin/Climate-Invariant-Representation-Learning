#!/bin/bash
#PBS -N cmip_exp5_ClimaX
#PBS -A UCLB0066
#PBS -q main
#PBS -l select=1:ncpus=20:mem=200GB:ngpus=1
#PBS -l walltime=16:00:00
#PBS -o /glade/u/home/tsalin/CMIP/logs/exp5_variable_baseline_ClimaX.out
#PBS -e /glade/u/home/tsalin/CMIP/logs/exp5_variable_baseline_ClimaX.err

set -euo pipefail

# Pré-soumettre le job suivant avant de commencer : il ne démarrera que si ce
# job se termine en erreur (walltime, OOM, crash), pas si exit 0.
CKPT="/glade/u/home/tsalin/CMIP/model_evaluation/Baseline_ClimaX/climax_finetune_checkpoint.pt"
NEXT_JOB=$(qsub -W depend=afternotok:"$PBS_JOBID" \
  "$PBS_O_WORKDIR/run_exp5_variable_baseline_ClimaX.pbs")
echo "[PBS] Job successeur pré-soumis : $NEXT_JOB (démarre uniquement si ce job échoue)"

PROJECT_DIR="/glade/u/home/tsalin/CMIP"
WORK_DIR="/glade/work/tsalin/CMIP"
mkdir -p "$PROJECT_DIR/logs"
mkdir -p "$PROJECT_DIR/model_evaluation/Baseline_ClimaX"
cd "$PROJECT_DIR/jobs"

# Initialize conda in PBS shell
__conda_setup="$('/glade/u/apps/jupyterhub/jh-23.11/bin/conda' 'shell.bash' 'hook' 2>/dev/null)"
if [ $? -eq 0 ]; then eval "$__conda_setup"; fi
unset __conda_setup
module load conda
conda activate cmip

python -u run_exp5_variable_baseline_ClimaX.py \
  --project-dir "$PROJECT_DIR" \
  --notebook notebooks/trainings/variable/CMIP_variable_exp5_baseline_ClimaX.ipynb \
  --plots-dir "$WORK_DIR/plots/plots_exp_5" \
  --latents-dir "$WORK_DIR/latent_representations/latent_representations_exp_5" \
  --evaluation-dir "$WORK_DIR/model_evaluation/Baseline_ClimaX" \
  --executed-notebook "$WORK_DIR/executed_notebooks/CMIP_variable_exp5_baseline_ClimaX.executed.ipynb" \
  --timeout 0

# Si Python s'est terminé normalement (exit 0), annuler le job successeur
# car tout est fini — le checkpoint a été supprimé par le notebook.
qdel "$NEXT_JOB" 2>/dev/null && echo "[PBS] Job successeur annulé : entraînement et évaluation terminés." || true
